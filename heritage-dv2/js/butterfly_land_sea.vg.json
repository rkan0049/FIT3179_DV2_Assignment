{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Butterfly chart: historic places (land) vs underwater cultural heritage sites added to registers by jurisdiction, 2016-17 to 2019-20.",
  "background": null,
  "data": {
    "url": "data/register_additions_land_sea.csv",
    "format": {
      "parse": {
        "added": "number"
      }
    }
  },
  "transform": [
    {
      "aggregate": [
        {
          "op": "sum",
          "field": "added",
          "as": "total"
        },
        {
          "op": "valid",
          "field": "added",
          "as": "n"
        }
      ],
      "groupby": [
        "jurisdiction",
        "jurisdiction_name",
        "type"
      ]
    },
    {
      "calculate": "datum.n == 0 ? 'no register' : format(datum.total, ',')",
      "as": "label"
    },
    {
      "calculate": "datum.n == 0 ? 0 : datum.total",
      "as": "bar_value"
    }
  ],
  "spacing": 0,
  "hconcat": [
    {
      "width": 340,
      "height": {
        "step": 30
      },
      "title": {
        "text": "On land: historic places",
        "color": "#6b655a",
        "fontSize": 14,
        "anchor": "end"
      },
      "transform": [
        {
          "filter": "datum.type == 'Historic places'"
        }
      ],
      "encoding": {
        "y": {
          "field": "jurisdiction",
          "type": "nominal",
          "sort": [
            "NSW",
            "Aust. Government",
            "QLD",
            "NT",
            "VIC",
            "WA",
            "ACT",
            "SA",
            "TAS"
          ],
          "axis": null
        },
        "x": {
          "field": "bar_value",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              230
            ],
            "reverse": true
          },
          "axis": {
            "title": null,
            "tickCount": 4,
            "grid": false
          }
        }
      },
      "layer": [
        {
          "mark": {
            "type": "bar",
            "color": "#8a8376",
            "height": {
              "band": 0.7
            }
          },
          "encoding": {
            "tooltip": [
              {
                "field": "jurisdiction_name",
                "title": "Jurisdiction"
              },
              {
                "field": "label",
                "title": "Historic places added"
              }
            ],
            "opacity": {
              "condition": [
                {
                  "param": "hover_l",
                  "empty": false,
                  "value": 1
                },
                {
                  "param": "hover_r",
                  "empty": false,
                  "value": 1
                },
                {
                  "test": "length(data('hover_l_store')) || length(data('hover_r_store'))",
                  "value": 0.3
                }
              ],
              "value": 1
            }
          },
          "params": [
            {
              "name": "hover_l",
              "select": {
                "type": "point",
                "fields": [
                  "jurisdiction"
                ],
                "on": "pointerover",
                "clear": "pointerout"
              }
            }
          ]
        },
        {
          "mark": {
            "type": "text",
            "align": "right",
            "dx": -5,
            "fontSize": 12
          },
          "encoding": {
            "text": {
              "field": "label"
            },
            "color": {
              "condition": {
                "test": "datum.n == 0",
                "value": "#8a8376"
              },
              "value": "#3c3831"
            },
            "opacity": {
              "condition": [
                {
                  "param": "hover_l",
                  "empty": false,
                  "value": 1
                },
                {
                  "param": "hover_r",
                  "empty": false,
                  "value": 1
                },
                {
                  "test": "length(data('hover_l_store')) || length(data('hover_r_store'))",
                  "value": 0.3
                }
              ],
              "value": 1
            }
          }
        }
      ]
    },
    {
      "width": 120,
      "height": {
        "step": 30
      },
      "view": {
        "stroke": null
      },
      "transform": [
        {
          "filter": "datum.type == 'Historic places'"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 13,
        "fontWeight": "bold",
        "color": "#3c3831"
      },
      "encoding": {
        "y": {
          "field": "jurisdiction",
          "type": "nominal",
          "sort": [
            "NSW",
            "Aust. Government",
            "QLD",
            "NT",
            "VIC",
            "WA",
            "ACT",
            "SA",
            "TAS"
          ],
          "axis": null
        },
        "text": {
          "field": "jurisdiction"
        },
        "opacity": {
          "condition": [
            {
              "param": "hover_l",
              "empty": false,
              "value": 1
            },
            {
              "param": "hover_r",
              "empty": false,
              "value": 1
            },
            {
              "test": "length(data('hover_l_store')) || length(data('hover_r_store'))",
              "value": 0.3
            }
          ],
          "value": 1
        }
      }
    },
    {
      "width": 340,
      "height": {
        "step": 30
      },
      "title": {
        "text": "Underwater: shipwrecks and other sites",
        "color": "#4f6a85",
        "fontSize": 14,
        "anchor": "start"
      },
      "transform": [
        {
          "filter": "datum.type == 'Underwater sites'"
        }
      ],
      "encoding": {
        "y": {
          "field": "jurisdiction",
          "type": "nominal",
          "sort": [
            "NSW",
            "Aust. Government",
            "QLD",
            "NT",
            "VIC",
            "WA",
            "ACT",
            "SA",
            "TAS"
          ],
          "axis": null
        },
        "x": {
          "field": "bar_value",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              230
            ]
          },
          "axis": {
            "title": null,
            "tickCount": 4,
            "grid": false
          }
        }
      },
      "layer": [
        {
          "mark": {
            "type": "bar",
            "color": "#9fb4c7",
            "height": {
              "band": 0.7
            }
          },
          "encoding": {
            "tooltip": [
              {
                "field": "jurisdiction_name",
                "title": "Jurisdiction"
              },
              {
                "field": "label",
                "title": "Underwater sites added"
              }
            ],
            "opacity": {
              "condition": [
                {
                  "param": "hover_l",
                  "empty": false,
                  "value": 1
                },
                {
                  "param": "hover_r",
                  "empty": false,
                  "value": 1
                },
                {
                  "test": "length(data('hover_l_store')) || length(data('hover_r_store'))",
                  "value": 0.3
                }
              ],
              "value": 1
            }
          },
          "params": [
            {
              "name": "hover_r",
              "select": {
                "type": "point",
                "fields": [
                  "jurisdiction"
                ],
                "on": "pointerover",
                "clear": "pointerout"
              }
            }
          ]
        },
        {
          "mark": {
            "type": "text",
            "align": "left",
            "dx": 5,
            "fontSize": 12
          },
          "encoding": {
            "text": {
              "field": "label"
            },
            "color": {
              "condition": {
                "test": "datum.n == 0",
                "value": "#8a8376"
              },
              "value": "#3c3831"
            },
            "opacity": {
              "condition": [
                {
                  "param": "hover_l",
                  "empty": false,
                  "value": 1
                },
                {
                  "param": "hover_r",
                  "empty": false,
                  "value": 1
                },
                {
                  "test": "length(data('hover_l_store')) || length(data('hover_r_store'))",
                  "value": 0.3
                }
              ],
              "value": 1
            }
          }
        },
        {
          "comment": "Annotation inside the NSW bar",
          "transform": [
            {
              "filter": "datum.jurisdiction == 'NSW'"
            }
          ],
          "mark": {
            "type": "text",
            "align": "right",
            "dx": -34,
            "fontSize": 12,
            "fontStyle": "italic",
            "color": "#ffffff",
            "fontWeight": 600
          },
          "encoding": {
            "text": {
              "value": "more than half of all underwater sites"
            }
          }
        },
        {
          "comment": "Annotation next to WA",
          "transform": [
            {
              "filter": "datum.jurisdiction == 'WA'"
            }
          ],
          "mark": {
            "type": "text",
            "align": "left",
            "dx": 18,
            "fontSize": 12,
            "fontStyle": "italic",
            "color": "#3c3831"
          },
          "encoding": {
            "text": {
              "value": "none, despite the longest coastline"
            }
          }
        }
      ]
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "font": "'Source Sans 3', sans-serif",
    "axis": {
      "labelColor": "#5b5850",
      "domainColor": "#e6dfd2",
      "tickColor": "#e6dfd2"
    },
    "concat": {
      "spacing": 0
    }
  }
}