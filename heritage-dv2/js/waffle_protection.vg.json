{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Waffle charts: share of Indigenous stakeholders surveyed for State of the Environment 2021 who did not believe Indigenous heritage is adequately protected by law (92%), and who did not feel empowered to manage their own heritage (53%).",
  "background": null,
  "spacing": 36,
  "hconcat": [
    {
      "width": 180,
      "height": 180,
      "title": {
        "text": "92%",
        "subtitle": [
          "did not believe Indigenous heritage",
          "is adequately protected by",
          "Australian laws"
        ],
        "anchor": "start",
        "font": "Fraunces, Georgia, serif",
        "fontSize": 34,
        "fontWeight": 700,
        "color": "#9a6a12",
        "subtitleFont": "'Source Sans 3', sans-serif",
        "subtitleFontSize": 13,
        "subtitleColor": "#3c3831",
        "subtitlePadding": 6,
        "offset": 12,
        "subtitleFontWeight": "normal",
        "subtitleLineHeight": 17
      },
      "layer": [
        {
          "data": {
            "sequence": {
              "start": 0,
              "stop": 100,
              "as": "i"
            }
          },
          "transform": [
            {
              "calculate": "floor(datum.i / 10)",
              "as": "row"
            },
            {
              "calculate": "datum.i % 10",
              "as": "col"
            },
            {
              "calculate": "datum.i < 92 ? 'Yes' : 'No'",
              "as": "filled"
            },
            {
              "calculate": "datum.filled == 'Yes' ? '92 in 100' : '8 in 100'",
              "as": "share"
            }
          ],
          "mark": {
            "type": "square",
            "size": 210,
            "cornerRadius": 2,
            "opacity": 1
          },
          "encoding": {
            "x": {
              "field": "col",
              "type": "ordinal",
              "axis": null
            },
            "y": {
              "field": "row",
              "type": "ordinal",
              "axis": null,
              "sort": "descending"
            },
            "color": {
              "field": "filled",
              "type": "nominal",
              "scale": {
                "domain": [
                  "Yes",
                  "No"
                ],
                "range": [
                  "#9a6a12",
                  "#ece5d6"
                ]
              },
              "legend": null
            },
            "tooltip": [
              {
                "field": "share",
                "title": "Respondents"
              }
            ],
            "opacity": {
              "condition": {
                "param": "sq_hover_0",
                "value": 1
              },
              "value": 0.35
            }
          },
          "params": [
            {
              "name": "sq_hover_0",
              "select": {
                "type": "point",
                "fields": [
                  "filled"
                ],
                "on": "pointerover",
                "clear": "pointerout"
              }
            }
          ]
        },
        {
          "comment": "Annotation",
          "data": {
            "values": [
              {}
            ]
          },
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "top",
            "x": 0,
            "y": {
              "expr": "height + 10"
            },
            "fontSize": 12,
            "fontStyle": "italic",
            "color": "#5b5850"
          },
          "encoding": {
            "text": {
              "value": "Only 8 in 100 said the law is enough"
            }
          }
        }
      ]
    },
    {
      "width": 180,
      "height": 180,
      "title": {
        "text": "53%",
        "subtitle": [
          "did not feel empowered to",
          "manage their own heritage",
          " "
        ],
        "anchor": "start",
        "font": "Fraunces, Georgia, serif",
        "fontSize": 34,
        "fontWeight": 700,
        "color": "#9a6a12",
        "subtitleFont": "'Source Sans 3', sans-serif",
        "subtitleFontSize": 13,
        "subtitleColor": "#3c3831",
        "subtitlePadding": 6,
        "offset": 12,
        "subtitleFontWeight": "normal",
        "subtitleLineHeight": 17
      },
      "layer": [
        {
          "data": {
            "sequence": {
              "start": 0,
              "stop": 100,
              "as": "i"
            }
          },
          "transform": [
            {
              "calculate": "floor(datum.i / 10)",
              "as": "row"
            },
            {
              "calculate": "datum.i % 10",
              "as": "col"
            },
            {
              "calculate": "datum.i < 53 ? 'Yes' : 'No'",
              "as": "filled"
            },
            {
              "calculate": "datum.filled == 'Yes' ? '53 in 100' : '47 in 100'",
              "as": "share"
            }
          ],
          "mark": {
            "type": "square",
            "size": 210,
            "cornerRadius": 2,
            "opacity": 1
          },
          "encoding": {
            "x": {
              "field": "col",
              "type": "ordinal",
              "axis": null
            },
            "y": {
              "field": "row",
              "type": "ordinal",
              "axis": null,
              "sort": "descending"
            },
            "color": {
              "field": "filled",
              "type": "nominal",
              "scale": {
                "domain": [
                  "Yes",
                  "No"
                ],
                "range": [
                  "#9a6a12",
                  "#ece5d6"
                ]
              },
              "legend": null
            },
            "tooltip": [
              {
                "field": "share",
                "title": "Respondents"
              }
            ],
            "opacity": {
              "condition": {
                "param": "sq_hover_1",
                "value": 1
              },
              "value": 0.35
            }
          },
          "params": [
            {
              "name": "sq_hover_1",
              "select": {
                "type": "point",
                "fields": [
                  "filled"
                ],
                "on": "pointerover",
                "clear": "pointerout"
              }
            }
          ]
        },
        {
          "comment": "Annotation",
          "data": {
            "values": [
              {}
            ]
          },
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "top",
            "x": 0,
            "y": {
              "expr": "height + 10"
            },
            "fontSize": 12,
            "fontStyle": "italic",
            "color": "#5b5850"
          },
          "encoding": {
            "text": {
              "value": "47 in 100 felt empowered"
            }
          }
        }
      ]
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "font": "'Source Sans 3', sans-serif",
    "concat": {
      "spacing": 36
    }
  }
}